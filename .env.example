# Predator Agent — העתק ל-.env ומלא ערכים אמיתיים
# cp .env.example .env

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SIP_TRUNK_ID=your_livekit_sip_trunk_id

# STT / TTS
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_MALE=ff857c8e-e7f9-4afd-af42-dce9f3c5ab02
CARTESIA_VOICE_FEMALE=3e32f3c5-9ac0-4192-9994-87fdb277120f

# LLMs — Fast: Groq → OpenAI fallback | Slow: Claude Sonnet 5
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your_anthropic_api_key
SLOW_LLM_MODEL=claude-sonnet-5

# Twilio / SIP
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+972500000000
TWILIO_SIP_DOMAIN=your-domain.sip.twilio.com

# Dialer
DIALER_RATE_LIMIT=10
DIALER_WORK_START_HOUR=8
DIALER_WORK_END_HOUR=21
LEADS_CSV=data/leads.csv
INBOUND_WHITELIST_CSV=data/inbound_whitelist.csv

# WhatsApp follow-up
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_DRY_RUN=true
CAMPAIGN_MANAGER_WHATSAPP=whatsapp:+972500000001
CANDIDATE_NAME=שם המועמד
POLL_LOCATION=בית הספר השכונתי
POLL_HOURS=07:00-22:00

# Live ops
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
WHISPER_ENABLED=true
WHISPER_HOST=0.0.0.0
WHISPER_PORT=9001

# Post-call push
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POSTCALL_LLM_MODEL=gpt-4.1-mini

# Persuadability / AB
PERSUADABILITY_MODEL_PATH=
AB_BANDIT_STATE=data/ab_bandit_state.json

# Runtime
AGENT_MODE=dev
SILENCE_TIMEOUT_SEC=4
